# ============================================================
# zxssxsc 环境变量清单
# 复制为 .env.local 使用：cp .env.example .env.local
# ============================================================

# ---------- Supabase（可选） ----------
# 留空 => 自动进入 mock 模式，前端用内置模拟数据跑通全部交互，
#          提交写入进程内存储，无需数据库即可演示。
# 填上 => 自动切换到 Supabase 真实读写。
#
# 注意：这两个变量**不需要** NEXT_PUBLIC_ 前缀。
# 浏览器不直接持有 Supabase 凭据，所有读写都经由服务端 /api/* 路由完成，
# 服务端使用 anon key 时 RLS 依然生效。这样避免把端点暴露给前端被刷。
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 服务端专用：用于写入版本历史快照 + 跨实例严格限流计数（绕过 RLS）。
# 不填则这两项自动降级（快照改用 anon 写入，限流退回进程内计数）。
# 切勿泄露到客户端。
SUPABASE_SERVICE_ROLE_KEY=

# 兼容写法：若你更习惯 NEXT_PUBLIC_ 前缀，这两个名字也会被识别
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- 地图瓦片 ----------
# 默认 auto：浏览器并发测速 3 个国内可访问的 OSM 镜像，选响应最快的那个。
# 只有当你明确想固定某个镜像时才改成具体值。
#
# 可选值：auto | hot | osmfr | de | tian | osm
# auto  = 自动测速选源（默认，推荐）
# hot   = https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png   人道主义高对比风格
# osmfr = https://{s}.tile.openstreetmap.fr/osmfr/{z}/{x}/{y}.png 标准风格，实测最快
# de    = https://tile.openstreetmap.de/{z}/{x}/{y}.png           上游缓存时间最长
# tian  = 天地图（需 NEXT_PUBLIC_TIANDITU_KEY，国内最稳）
# osm   = 官方 tile.openstreetmap.org（默认禁用，国内会加载失败，仅调试用）
#
# 实测已排除的死链，不要再加回来：
#   tile.openstreetmap.bzh / osm.nixqz.com / maps.wikimedia.org / basemaps.cartocdn.com
NEXT_PUBLIC_TILE_PROVIDER=auto

# 天地图 Key（仅当 NEXT_PUBLIC_TILE_PROVIDER=tian 时必填）
# 免费申请：https://console.tianditu.gov.cn/api/key
NEXT_PUBLIC_TIANDITU_KEY=

# ---------- 大学自动定位（高德 Web 服务） ----------
# 用途：在「新增/修改大学校历」表单里输入大学全名后，自动获取省/市/经纬度并在地图上定位。
#
# ⚠️ 必须是高德控制台里类型为「Web服务」的 Key。
#    JS API 的 Key（用于网页地图的那种）不能用于服务端调用，
#    用错会返回 USER_KEY_PLATFORM_MISMATCH。
#
# ⚠️ 不要加 NEXT_PUBLIC_ 前缀：这个 Key 只在服务端使用，
#    暴露到浏览器会被人盗用刷掉你的调用配额。
#
# 免费申请：https://console.amap.com/dev/key/app  （选「Web服务」类型）
# 不配置也能用：表单会提示无法自动定位，用户手动选省市 + 地图选点即可。
AMAP_WEB_KEY=

# ---------- 防滥用 ----------
# 同一 IP 每小时最多提交次数（默认 3）
SUBMIT_RATE_LIMIT_PER_HOUR=3
# 表单加载到提交的最短间隔，毫秒（默认 3000）
SUBMIT_MIN_FILL_MS=3000
# 设为 1 可关闭全部反滥用检查（仅本地调试用）
DISABLE_ANTI_ABUSE=0

# ---------- 站点 ----------
# 顶栏站点展示名（项目代号仍是 zxssxsc，只是展示用中文名）
NEXT_PUBLIC_SITE_NAME=上学时长
